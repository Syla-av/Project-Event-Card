@page "/events/{Id:int}"
@inject EventStore Store

<PageTitle>Event details | EventEase</PageTitle>
<NavLink href="events">← All events</NavLink>
@if (currentEvent is null)
{
    <h1>Event not found</h1>
    <p>Please choose an event from the event list.</p>
}
else
{
    <section class="panel">
        <p class="eyebrow">@currentEvent.Category</p>
        <h1>@currentEvent.Name</h1>
        <dl>
            <dt>Date</dt>
            <dd>@currentEvent.Date.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</dd>
            <dt>Location</dt>
            <dd>@currentEvent.Location</dd>
        </dl>
        <p>@currentEvent.Description</p>
        <NavLink class="button" href="@($"events/{Id}/register")">Register for this event</NavLink>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    private EventModel? currentEvent;

    // Runs again when navigation changes the route parameter on this page.
    protected override void OnParametersSet() => currentEvent = Store.Find(Id);
}
